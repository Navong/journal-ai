# Copy to .env.local (recommended) or .env and fill in values. Never commit real secrets.

# Gemini (reflections, embeddings, chat)
NEXT_PUBLIC_GEMINI_API_KEY=
# GEMINI_API_KEY=

# NextAuth
AUTH_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Database (if used)
# DATABASE_URL=
# DIRECT_URL=
